#define ZMK_POINTING_DEFAULT_MOVE_VAL 800  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 200    // 10

/* ===== Layer Indexes ===== */
#define L_DEFAULT  0
#define L_GAMING   1
#define L_NAV      2
#define L_NUMBER   3
#define L_FKEYS    4
#define L_FN       5
#define L_MEDIA    6


#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <input/processors.dtsi>

/* ===== Fast Mouse Movement (2x normal speed) ===== */
#define FAST_MOVE_VAL  (ZMK_POINTING_DEFAULT_MOVE_VAL * 4)
#define FAST_UP        MOVE_Y(-FAST_MOVE_VAL)
#define FAST_DOWN      MOVE_Y(FAST_MOVE_VAL)
#define FAST_LEFT      MOVE_X(-FAST_MOVE_VAL)
#define FAST_RIGHT     MOVE_X(FAST_MOVE_VAL)

&msc {
  acceleration-exponent = <0>;         // 0
  time-to-max-speed-ms = <300>;  // 300
  delay-ms = <0>;                      // 0
};


&mmv {
  acceleration-exponent = <1>;
  time-to-max-speed-ms = <1200>;
};


/ {
  behaviors {
    td0: td0 {
      compatible = "zmk,behavior-tap-dance";
      display-name = "Shift/Caps Lock Tap Dance";
      #binding-cells = <0>;
      tapping-term-ms = <300>;
      bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
    };

    mmv_up: mmv_up {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&mmv MOVE_UP>, <&mmv FAST_UP>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
      keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    mmv_down: mmv_down {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&mmv MOVE_DOWN>, <&mmv FAST_DOWN>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
      keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    mmv_left: mmv_left {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&mmv MOVE_LEFT>, <&mmv FAST_LEFT>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
      keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    mmv_right: mmv_right {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&mmv MOVE_RIGHT>, <&mmv FAST_RIGHT>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
      keep-mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    minus_under: minus_under {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp MINUS>, <&kp UNDER>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    rsr_vol: rsr_vol {
      compatible = "zmk,behavior-runtime-sensor-rotate";
      #sensor-binding-cells = <0>;
      tap-ms = <5>;
      cw-binding = <&kp C_VOL_UP>;
      ccw-binding = <&kp C_VOL_DN>;
    };
  };

  td_fn: td_fn {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      bindings = <&kp LALT>, <&tog L_FN>, <&to L_GAMING>;
      tapping-term-ms = <200>;
  };

  parens: parens {
    compatible = "zmk,behavior-macro";
    label = "()";
    #binding-cells = <0>;
    bindings = <&kp LPAR>, <&kp RPAR>, <&kp LEFT>;
  };

  brackets: brackets {
    compatible = "zmk,behavior-macro";
    label = "[]";
    #binding-cells = <0>;
    bindings = <&kp LBKT>, <&kp RBKT>, <&kp LEFT>;
  };

  braces: braces {
    compatible = "zmk,behavior-macro";
    label = "{}";
    #binding-cells = <0>;
    bindings = <&kp LBRC>, <&kp RBRC>, <&kp LEFT>;
  };


  combos {
    compatible = "zmk,combos";

    combo_braces {
      timeout-ms = <50>;
      key-positions = <7 8>;
      bindings = <&braces>;
    };

    combo_parens {
      timeout-ms = <50>;
      key-positions = <22 23>;
      bindings = <&parens>;
    };

    combo_brackets {
      timeout-ms = <50>;
      key-positions = <36 37>;
      bindings = <&brackets>;
    };

    combo_equal {
      timeout-ms = <50>;
      key-positions = <4 5>;
      bindings = <&kp EQUAL>;
    };

    combo_minus {
      timeout-ms = <50>;
      key-positions = <17 18>;
      bindings = <&minus_under>;
    };

    combo_plus {
      timeout-ms = <50>;
      key-positions = <32 33>;
      bindings = <&kp PLUS>;
    };

    combo_grave {
      timeout-ms = <50>;
      key-positions = <0 13>;
      bindings = <&kp GRAVE>;
    };

    combo_excl {
      timeout-ms = <50>;
      key-positions = <1 14>;
      bindings = <&kp EXCL>;
    };

    combo_at {
      timeout-ms = <50>;
      key-positions = <2 15>;
      bindings = <&kp AT>;
    };

    combo_hash {
      timeout-ms = <50>;
      key-positions = <3 16>;
      bindings = <&kp HASH>;
    };

    combo_dllr {
      timeout-ms = <50>;
      key-positions = <4 17>;
      bindings = <&kp DLLR>;
    };

    combo_prcnt {
      timeout-ms = <50>;
      key-positions = <5 18>;
      bindings = <&kp PRCNT>;
    };

    combo_caret {
      timeout-ms = <50>;
      key-positions = <7 22>;
      bindings = <&kp CARET>;
    };

    combo_amps {
      timeout-ms = <50>;
      key-positions = <8 23>;
      bindings = <&kp AMPS>;
    };

    combo_astrk {
      timeout-ms = <50>;
      key-positions = <9 24>;
      bindings = <&kp ASTRK>;
    };

    combo_tilde {
      timeout-ms = <50>;
      key-positions = <10 25>;
      bindings = <&kp TILDE>;
    };

    combo_bslh {
      timeout-ms = <50>;
      key-positions = <11 26>;
      bindings = <&kp BSLH>;
    };

    combo_pipe {
      timeout-ms = <50>;
      key-positions = <12 27>;
      bindings = <&kp PIPE>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "QWERTY";
      bindings =
          <
            &kp TAB    &kp Q  &kp W     &kp E     &kp R      &kp T                                                   &mmv_up                           &kp Y              &kp U  &kp I      &kp O    &kp P     &kp BSPC
            &td0       &kp A  &kp S     &kp D     &kp F      &kp G                                    &mmv_left &mkp LCLK  &mmv_right             &kp H              &kp J  &kp K      &kp L    &kp SEMI  &mt RALT SQT
            &kp LCTRL  &kp Z  &kp X     &kp C     &kp V      &kp B        &kp C_PLAY_PAUSE                           &mmv_down                         &kp N              &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                                        &kp LGUI  &mo L_NAV  &lt L_NUMBER SPACE                                                                        &lt L_FKEYS ENTER  &mo L_MEDIA       &td_fn
          >;

      sensor-bindings = <&rsr_vol &rsr_trans>;
    };

    gaming_layer {
      display-name = "GAMING";
      bindings =
        <
          &kp TAB    &kp Q  &kp W     &kp E     &kp R      &kp T                                   &mmv_up                           &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BSPC
          &kp LSHIFT &kp A  &kp S     &kp D     &kp F      &kp G                   &mmv_left      &mkp LCLK  &mmv_right              &kp H        &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
          &kp LCTRL  &kp Z  &kp X     &kp C     &kp V      &kp B   &kp C_PLAY_PAUSE                &mmv_down                         &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                                      &kp LGUI  &mo L_NAV  &kp SPACE                                                                 &kp ENTER    &none  &to L_DEFAULT
        >;
    
      sensor-bindings = <&rsr_vol &rsr_trans>;
    };

    nav_layer {
      display-name = "NAV";
      bindings =
        <
          &kp N6  &kp N1 &kp N2 &kp N3  &kp N4  &kp N5                                              &msc SCRL_UP                     &kp HOME     &kp END    &none      &none       &none            &trans
          &trans  &kp F1 &kp F2 &kp F3  &kp F4  &kp F5                              &msc SCRL_LEFT  &trans    &msc SCRL_RIGHT        &kp LEFT     &kp DOWN   &kp UP     &kp RIGHT   &kp PRINTSCREEN  &none
          &trans  &none  &none  &none   &none   &none            &trans                             &msc SCRL_DOWN                   &kp PG_UP    &kp PG_DN  &none      &none       &kp SCROLLLOCK   &trans
                                &trans  &trans  &trans                                                                               &trans       &kp DEL    &trans
        >;

      sensor-bindings = <&rsr_vol &rsr_trans>;
    };

    number_layer{
      display-name = "NUMBER";
      bindings =
        <
          &none  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                          &trans                   &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
          &trans &trans &trans &trans &trans &trans                    &trans  &trans  &trans           &trans  &trans  &trans  &trans  &trans  &trans
          &trans &trans &trans &trans &trans &trans   &trans                   &trans                   &trans  &trans  &trans  &trans  &trans  &trans
                               &trans &trans &trans                                                     &trans  &trans  &trans
        >;

      sensor-bindings = <&rsr_vol &rsr_trans>;
    };

    f_keys_layer{
      display-name = "F1-12";
      bindings =
        <
          &studio_unlock  &kp F1      &kp F2     &kp F3       &kp F4     &kp F5                                    &trans                   &none  &none   &none  &none  &none &none
          &trans          &kp F6      &kp F7     &kp F8       &kp F9     &kp F10                           &trans  &trans  &trans           &none  &none   &none  &none  &none &none
          &trans          &kp F11     &kp F12    &none        &none      &none       &trans                        &trans                   &none  &none   &none  &none  &none &none
                                                 &trans       &trans     &trans                                                             &trans &trans  &td_fn
        >;

      sensor-bindings = <&rsr_vol &rsr_trans>;
    };

    fn_layer{
      display-name = "FN";
      bindings = 
        <
          &none       &none    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3                                         &rgb_ug RGB_BRI                     &rgb_ug RGB_COLOR_HSB(0,0,100) &rgb_ug RGB_COLOR_HSB(180,100,100) &rgb_ug RGB_COLOR_HSB(20,93,100 ) &rgb_ug RGB_COLOR_HSB(300,100,100) &rgb_ug RGB_COLOR_HSB(330,60,100) &rgb_ug RGB_COLOR_HSB(150,60,100)
          &none       &none    &none           &none           &none            &none                               &rgb_ug RGB_EFR  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF    &out OUT_USB     &out OUT_BLE   &none   &none &none &none
          &bt BT_CLR  &none    &none           &none           &sys_reset       &bootloader          &trans                          &rgb_ug RGB_BRD                     &bootloader      &sys_reset     &none   &none &none &none
                                               &trans          &trans           &trans                                                                                   &trans           &trans         &trans
        >;

      sensor-bindings = <&rsr_vol &rsr_trans>;
    };


    media_layer {
      display-name = "MEDIA";
      bindings =
        <
          &trans &trans &trans &trans &trans &trans                                        &trans                   &kp C_PREV  &kp C_NEXT  &kp C_PP    &kp C_VOL_DN  &kp C_VOL_UP  &trans
          &trans &trans &trans &trans &trans &trans                               &trans  &trans  &trans           &mkp MB4    &mkp RCLK   &mkp MCLK   &mkp MB5      &trans        &trans
          &trans &trans &trans &trans &trans &trans   &trans                              &trans                   &trans        &trans      &trans      &trans      &trans        &trans
                                      &trans &trans   &trans                                                       &trans        &trans      &trans
        >;

      sensor-bindings = <&rsr_vol &rsr_trans>;
    };

};
};

